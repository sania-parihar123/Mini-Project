# ProcessFoundry AI Environment Configuration
# Copy this file to .env and adjust variables as needed.

# Database: PostgreSQL connection URI (e.g. Supabase connection pooler or local PostgreSQL).
# MANDATORY for normal application runs. The application will fail fast on startup if missing.
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres

# Local Testing Override: Set to true ONLY for isolated automated test runs or offline dev environments.
# SQLite fallback is restricted and will raise an error in production environments without this flag.
ALLOW_SQLITE=false

# Security: Secret key for signing authentication session tokens (generate a secure random string)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# LLM Gateway: Provider choice (gemini or mock)
LLM_PROVIDER=gemini

# Google AI Studio Gemini API Key (keep secret, never commit)
LLM_API_KEY=your-gemini-api-key-here

# Gemini Model name
LLM_MODEL=gemini-2.5-flash

# Model timeout in seconds
LLM_TIMEOUT_SECONDS=60

# Application URLs
API_BASE_URL=http://localhost:8000
APP_BASE_URL=http://localhost:8501

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# Optional SMTP configuration for invitation emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@processfoundry.ai
